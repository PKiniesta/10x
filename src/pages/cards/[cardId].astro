---
import Layout from "@/layouts/Layout.astro";
import CardDetailsPage from "@/components/cards/CardDetailsPage.tsx";

const { cardId } = Astro.params;

if (!cardId) {
  throw new Error("Missing cardId param");
}
---

<Layout title="Szczegóły fiszki">
  <main class="mx-auto w-full max-w-3xl px-4 py-8">
    <CardDetailsPage client:load cardId={cardId} />
  </main>
</Layout>
