---
import { ThemeToggle } from "@/components/ThemeToggle";

// Placeholder for user presence - logic will be added later
const user = null;
---

<header class="border-b bg-background">
  <div class="mx-auto flex h-16 max-w-3xl items-center justify-between px-4">
    <nav class="flex items-center gap-6 text-sm font-medium">
      <a href="/" class="text-base font-bold text-primary">10x Fiszki</a>
      {
        user ? (
          <>
            <a href="/cards" class="transition-colors hover:text-primary">
              Lista fiszek
            </a>
            <a href="/ai/generate" class="transition-colors hover:text-primary">
              Generuj z AI
            </a>
            <a href="/cards/new" class="transition-colors hover:text-primary">
              Generuj manualnie
            </a>
          </>
        ) : null
      }
    </nav>
    <div class="flex items-center gap-4">
      {
        !user ? (
          <>
            <a href="/login" class="text-sm font-medium transition-colors hover:text-primary">
              Zaloguj się
            </a>
            <a
              href="/register"
              class="bg-primary text-primary-foreground hover:bg-primary/90 rounded-md px-3 py-1.5 text-sm font-medium transition-colors"
            >
              Zarejestruj się
            </a>
          </>
        ) : (
          <span class="text-sm font-medium">Witaj!</span>
        )
      }
      <ThemeToggle client:load />
    </div>
  </div>
</header>
