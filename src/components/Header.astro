---
import { ThemeToggle } from "@/components/ThemeToggle";

const { user } = Astro.locals;
---

<header class="border-b bg-background" data-test-id="header">
  <div class="mx-auto flex h-16 max-w-3xl items-center justify-between px-4">
    <nav class="flex items-center gap-6 text-sm font-medium">
      <a href="/" class="text-base font-bold text-primary">10x Fiszki</a>
      {
        user ? (
          <>
            <a href="/cards" class="transition-colors hover:text-primary" data-test-id="header-link-cards-list">
              Lista fiszek
            </a>
            <a
              href="/cards/new"
              class="transition-colors hover:text-primary"
              data-test-id="header-link-generate-manual"
            >
              Generuj manualnie
            </a>
          </>
        ) : null
      }
    </nav>
    <div class="flex items-center gap-4">
      {
        !user ? (
          <>
            <a href="/login" class="text-sm font-medium transition-colors hover:text-primary" data-test-id="login-link">
              Zaloguj się
            </a>
            <a
              href="/register"
              class="bg-primary text-primary-foreground hover:bg-primary/90 rounded-md px-3 py-1.5 text-sm font-medium transition-colors"
              data-test-id="register-link"
            >
              Zarejestruj się
            </a>
          </>
        ) : (
          <div class="flex items-center gap-4">
            <span class="text-muted-foreground hidden text-sm sm:inline" data-test-id="header-user-email">
              {user.email}
            </span>
            <button
              id="logout-button"
              class="text-sm font-medium transition-colors hover:text-destructive"
              title="Wyloguj się"
              data-test-id="logout-button"
            >
              Wyloguj
            </button>
          </div>
        )
      }
      <ThemeToggle client:load />
    </div>
  </div>
</header>

<script>
  const logoutButton = document.getElementById("logout-button");
  if (logoutButton) {
    logoutButton.addEventListener("click", async () => {
      try {
        const response = await fetch("/api/auth/logout", {
          method: "POST",
        });
        if (response.ok) {
          window.location.href = "/login";
        }
      } catch (error) {
        console.error("Logout failed:", error);
        // eslint-disable-next-line prettier/prettier
      }
    });
  }
</script>
